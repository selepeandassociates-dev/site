{
  "name": "selepe-site",
  "version": "1.0.0",
  "private": true,
  "description": "Selepe & Associates Inc website",
  "scripts": {
    "build:pages": "python3 src/build.py",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --watch",
    "build": "npm run build:pages && npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
